						Code = Input { Value = "local tool = comp.ActiveTool\n\nlocal function FindChildNode(groupNode, childNodeType, childNodeName)\n    local nodeList = groupNode:GetChildrenList()\n\n    for _, childNode in ipairs(nodeList) do\n      if childNode:GetAttrs().TOOLS_RegID == childNodeType then\n\n          if string.find(childNode:GetAttrs().TOOLS_Name, childNodeName) then\n            return childNode\n          end\n      \n      end\n    end\n\nend\n\nlocal cropTool = FindChildNode(tool, \"Crop\", \"CR\")\nlocal icropTool = FindChildNode(tool, \"Crop\", \"invCR\")\n\nlocal MirrorAmount = tool.MirrorAmount[comp.CurrentTime]\n\nlocal function UpdateParms(locTool, wInp, hInp)\n    locTool:SetInput(wInp, cropTool.Input[comp.CurrentTime].Width*(1+(MirrorAmount*.1)) )\n    locTool:SetInput(hInp, cropTool.Input[comp.CurrentTime].Height*(1+(MirrorAmount*.1)) )\nend\n\nUpdateParms(cropTool, \"XSize\", \"YSize\")\nUpdateParms(FindChildNode(tool, \"FastNoise\", \"FN\"), \"Width\", \"Height\")\n\nicropTool:SetInput('XSize', icropTool.Input[comp.CurrentTime].Width/(1+(MirrorAmount*.1)) )\nicropTool:SetInput('YSize', icropTool.Input[comp.CurrentTime].Height/(1+(MirrorAmount*.1)) )\n--", },
